# Qdrant Configuration
QDRANT_HOST=http://qdrant:6333

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://{yourresource}.openai.azure.com/
AZURE_OPENAI_API_KEY=yoor_api_key_here  # Replace with your actual API key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt4-production  # or whatever your deployment name is
AZURE_OPENAI_REGION=westus3  # Change this to your region (e.g., eastus, westus, etc.)

HUGGINGFACE_TOKEN=hf_YourAccessTokenHere